<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Tenshinryu Hyoho Wiki</title>
  <meta name="description" content="{{ description }}">
  <link rel="stylesheet" href="/assets/style.css?v={{ css_version }}">
  {% for code, href in alternate.items() %}
  <link rel="alternate" hreflang="{{ code }}" href="{{ href }}">
  {% endfor %}
</head>
<body class="lang-{{ lang }}{% if is_index %} index-page{% endif %}">
  {% include "_nav.html.j2" %}
  <main>
    {% include "_breadcrumbs.html.j2" %}
    <div class="page-layout">
      <article class="page-content">
        {% if meta_line %}
        <p class="page-meta">{{ meta_line | safe }}</p>
        {% endif %}
        {% if render_page_h1 %}
        <h1 class="page-title">{{ title }}</h1>
        {% endif %}
        {{ content | safe }}
      </article>
      <aside class="page-sidebar" aria-label="{{ toc_label }}">
        <nav id="page-toc" class="page-toc">
          <p class="toc-heading">{{ toc_label }}</p>
        </nav>
      </aside>
    </div>
  </main>
  {% include "_footer.html.j2" %}
  <script src="/assets/search.js?v={{ css_version }}" defer></script>
  <script src="/assets/ask.js?v={{ css_version }}" defer></script>
  <script src="/assets/learn.js?v={{ css_version }}" defer></script>
  <script src="/assets/nav.js" defer></script>
  <script>window.WIKI_LANG = "{{ lang }}"; window.WIKI_ASSET_V = "{{ css_version }}";</script>
  <script>window.WIKI_ASK_STRINGS = {{ ask_js_strings | safe }};</script>
</body>
</html>
